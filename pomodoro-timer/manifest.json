{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Focus Timer"
   },
   "author": "Iker G.",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_end"
   } ],
   "description": "Floating Pomodoro timer on every tab. 25/5 min focus cycles, custom themes, study stats. Stay focused without switching windows.",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Focus Timer — Pomodoro Productivity Timer",
   "permissions": [ "storage", "scripting", "tabs", "notifications" ],
   "short_name": "Focus Timer",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.2.0"
}
